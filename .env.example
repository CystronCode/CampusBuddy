# ============================================================================
# CAMPUS INTELLIGENCE: LOCAL ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env and fill in your keys
# ============================================================================

# 1. Database Connections (PostgreSQL 16 with pgvector & pg_trgm)
# Tip: You can get a free PostgreSQL instance with pgvector at https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://app_write:CHANGE_ME_WRITE_SECRET@localhost:5432/postgres
DATABASE_URL_READONLY=postgresql://app_read:CHANGE_ME_READ_SECRET@localhost:5432/postgres

# 2. Security and Authentication
# Generate a random 64-char hex string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=super-secret-campus-jwt-key-change-in-prod-32chars
COOKIE_DOMAIN=
COOKIE_SECURE=false
COLLEGE_EMAIL_DOMAIN=college.edu
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# 3. Transactional Email (OTP Delivery)
# Get a free API key at https://resend.com
# For testing without real emails, set to: re_mock_test_key (codes will be logged to console)
EMAIL_API_KEY=re_mock_test_key
EMAIL_FROM=Campus Intelligence <auth@campus.edu>

# 4. Google Gemini API
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=mock_key
GEMINI_MODEL_ROUTER=gemini-2.0-flash-lite
GEMINI_MODEL_EXTRACT=gemini-2.0-flash
GEMINI_MODEL_SYNTH=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
RAG_MIN_SIMILARITY=0.45

# 5. Private Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_BUCKET=campus-intelligence-private
STORAGE_ACCESS_KEY=mock_storage_access_key
STORAGE_SECRET_KEY=mock_storage_secret_key

# 6. Application Runtime Constraints
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
TZ=Asia/Kolkata
